{
    "name": "traffic-simulator",
    "private": true,
    "version": "1.0.532",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "prebuild": "node scripts/generate-changelog.mjs",
        "build": "tsc -b && vite build",
        "postbuild": "node scripts/generate-checksums.mjs dist/index.html",
        "changelog": "node scripts/generate-changelog.mjs",
        "checksums": "node scripts/generate-checksums.mjs",
        "lint": "eslint .",
        "test": "vitest",
        "preview": "vite preview",
        "update-skus": "python scripts/parse_skus.py",
        "format": "prettier --write src/",
        "format:check": "prettier --check src/"
    },
    "dependencies": {
        "@xyflow/react": "^12.11.0",
        "html-to-image": "^1.11.11",
        "pdfmake": "^0.3.11",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "uuid": "^14.0.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz",
        "zustand": "^4.5.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.12.3",
        "@types/pdfmake": "^0.3.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/ui": "^4.1.9",
        "eslint": "^10.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "prettier": "^3.5.3",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.59.2",
        "vite": "^8.0.12",
        "vite-plugin-singlefile": "^2.3.3",
        "vitest": "^4.1.9"
    }
}
